             -e 's/^DEFAULT_IP=.*/DEFAULT_IP="10.90.90.68\/24"/' \
             -e 's/^DEFAULT_GATEWAY_IP=.*/DEFAULT_GATEWAY_IP="10.90.90.1"/' \
