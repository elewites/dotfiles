updatelog() {
         local services=(
             "/srv/nfsroot/lib/systemd/system/sel_async_data.service"
             "/srv/nfsroot/lib/systemd/system/sel_vf4w.service"
             "/srv/nfsroot/lib/systemd/system/sel_nx64f.service"
             "/srv/nfsroot/lib/systemd/system/sel_inventory_manager@.service"
         )

         for service_file in "${services[@]}"; do
             if [[ ! -f "$service_file" ]]; then
                 echo "Warning: Service file not found at $service_file"
                 continue
             fi

             sudo sed -i 's/LIBWIFE_LOG_LEVEL=3/LIBWIFE_LOG_LEVEL=4/' "$service_file"
             echo "Updated log level to 4 in $(basename "$service_file")"
         done
     }
updatefirewall () {
         local service_file="/srv/nfsroot/lib/systemd/system/sel_firewall_sapphire.service"

         if [[ ! -f "$service_file" ]]; then
             echo "Error: Service file not found at $service_file"
             return 1
         fi

         sudo sed -i 's/^ExecStart=/#ExecStart=/' "$service_file"
         sudo sed -i 's/^Restart=/#Restart=/' "$service_file"
         echo "Commented out ExecStart and Restart lines"
     }


