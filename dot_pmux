# Function names and descriptions (easy to customize)
declare -A PMUX_FUNCTIONS=(
    [bd]="Build and test all daemons"
    [bdaccess]="Build and test access module"
    [bdnx64]="Build and test nx64f daemon"
    [bdvf]="Build and test vf4w daemon"
    [bdasync]="Build and test async data daemon"
    [bdall]="Build and test all modules"
    [cpacces]="Copy access module library to nfsroot"
    [updatelog]="Update service log levels to 4"
    [updatefirewall]="Disable firewall service"
)

# Print menu with all available functions
menu() {
    echo ""
    echo "========== PMUX MENU =========="
    echo ""
    for func_name in "${!PMUX_FUNCTIONS[@]}"; do
        printf "  %-15s - %s\n" "$func_name" "${PMUX_FUNCTIONS[$func_name]}"
    done
    echo ""
    echo "==============================="
    echo ""
}

